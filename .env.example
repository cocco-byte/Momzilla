ANTHROPIC_API_KEY=sk-ant-...
MOMZILLA_MODEL_ID=claude-opus-5
MOMZILLA_DEBUG_LOG_TIERS=false

# Postgres connection string holding counselor accounts, the student
# roster, and escalation records (never conversation content). Required -
# e.g. an Aiven PostgreSQL service's connection string, which already
# includes sslmode=require.
MOMZILLA_DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Required in any real deployment - generate with `openssl rand -hex 32`.
# Anyone who has this value can forge a counselor session token.
MOMZILLA_JWT_SECRET=

# Comma-separated list of allowed frontend origins in production, e.g.
# https://chat.your-school.example,https://counselors.your-school.example
# Defaults to "*" (fine for local dev only).
MOMZILLA_CORS_ORIGINS=
